{
  "name": "auto-research-skill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "clean": "rimraf public",
    "build:site": "node scripts/build.mjs",
    "build:css": "tailwindcss -c tailwind.config.mjs -i ./src/styles/input.css -o ./public/assets/site.css --minify",
    "build": "pnpm run clean && pnpm run build:site && pnpm run build:css && pnpm run validate",
    "validate": "node scripts/validate.mjs && node scripts/verify-illustrations.mjs",
    "verify:public": "node scripts/verify-public.mjs",
    "dev": "node scripts/dev.mjs",
    "new:article": "node scripts/new-article.mjs",
    "test:design": "pnpm test:spatial && pnpm test:spatial:quality",
    "test:motion": "node scripts/test-spatial.mjs",
    "test:listing": "node scripts/test-spatial-quality.mjs",
    "test:arrival": "node scripts/test-spatial.mjs",
    "test:navigation": "node scripts/test-spatial.mjs",
    "test:quality": "node scripts/test-spatial-quality.mjs",
    "test:spatial": "node scripts/test-spatial.mjs",
    "test:spatial:quality": "node scripts/test-spatial-quality.mjs",
    "test:spatial:accessibility": "node scripts/test-spatial-accessibility.mjs",
    "verify:design": "node scripts/test-spatial-quality.mjs",
    "test:authoring": "node scripts/test-authoring.mjs",
    "verify:disclosures": "node scripts/verify-disclosures.mjs",
    "test:chapter-scroll": "node scripts/test-chapter-scroll.mjs",
    "test:topics-evidence": "node scripts/test-topics-evidence.mjs",
    "verify:illustrations": "node scripts/verify-illustrations.mjs",
    "test:illustrations": "node scripts/test-illustrations.mjs",
    "test:timeline-preview": "node scripts/test-timeline-preview.mjs"
  },
  "devDependencies": {
    "daisyui": "^4.12.24",
    "playwright": "1.62.1",
    "png-to-ico": "^3.0.1",
    "rimraf": "^6.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17"
  }
}
